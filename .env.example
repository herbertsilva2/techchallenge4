AZURE_SPEECH_KEY=sua_chave_aqui
AZURE_SPEECH_REGION=westus3
AZURE_SPEECH_ENDPOINT=https://westus3.api.cognitive.microsoft.com/
AZURE_SPEECH_LANGUAGE=pt-BR

# Alerta à equipe médica por SMTP (Gmail: senha de app, nunca a senha da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=seuemail@gmail.com
SMTP_PASSWORD=cole_sua_senha_de_app_aqui
SMTP_FROM=seuemail@gmail.com
ALERT_RECIPIENTS=destinatario@example.com
